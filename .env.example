# Central Configuration for Hybrid Order Data Pipeline (Phase 1 & Phase 2)

# File Router Threshold in Megabytes (Section 6.2)
SMALL_FILE_THRESHOLD_MB=200.0

# Batch Loading Batch Size (Section 6.3)
BATCH_SIZE=500

# Storage Backend ('auto', 'mongo', or 'json')
STORAGE_BACKEND=auto

# MongoDB Connection (Section 6.9)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=midterm_pipeline
MONGO_TIMEOUT_MS=1500

# API Settings (Section 5)
API_HOST=127.0.0.1
API_PORT=8000
